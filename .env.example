# ── SPA (legado AI Studio) ─────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── Backend (server/) ──────────────────────────────────────────────────
# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP del backend NestJS
PORT=3001

# Conexión a PostgreSQL (coincide con docker-compose.yml en local)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm_reclutamiento

# Conexión a Redis para BullMQ (coincide con docker-compose.yml en local)
REDIS_URL=redis://localhost:6379

# ── Credenciales de canal (channel-credentials) ────────────────────────
# Los secretos por canal (Meta app secret / verify token, tokens de WhatsApp,
# páginas de Meta y bots de Telegram) YA NO viven en env: se administran
# cifrados en la tabla channel_credentials vía POST/PATCH /api/channel-credentials.
#
# Llave maestra AES-256-GCM del almacén: base64 de exactamente 32 bytes.
# Generar con:  openssl rand -base64 32
# Sin ella, todos los canales quedan deshabilitados (webhooks 403, envío
# CHANNEL_NOT_CONFIGURED, media pending) sin impedir el arranque.
# En el primer arranque, si aún tienes las variables legacy de canal en tu
# entorno, el sistema las importa una vez al almacén; luego puedes borrarlas.
# CHANNEL_CREDENTIALS_KEY=

# Carpeta local donde se guardan los binarios de media (implementación
# filesystem de MediaStorage; S3/MinIO llegará con la decisión de despliegue).
# MEDIA_STORAGE_DIR=./storage/media

# Bot gateway: URL del webhook del servicio FastAPI del bot y secreto HMAC
# compartido (mín. 16 chars). Sin ellos, el bot queda desconectado.
# BOT_WEBHOOK_URL=http://localhost:8000/crm/webhook
# BOT_SHARED_SECRET=

# Base pública del backend (URLs absolutas para el bot, ej. media). Default:
# http://localhost:<PORT>. Con ngrok, la URL del túnel.
# PUBLIC_BASE_URL=

# Marketing API (read-only, permiso ads_read): sync de campañas reales.
# Sin estos dos, el sync queda deshabilitado y el CSV sigue siendo el fallback.
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_1234567890

# Bases de API (defaults oficiales; solo se cambian en tests o con proxy).
# GRAPH_API_BASE_URL=https://graph.facebook.com/v20.0
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# MARKETING_API_BASE_URL=https://graph.facebook.com/v20.0

# Orígenes permitidos para CORS de la API REST, separados por coma.
# Default: el dev server de Vite. En producción, el origen real de la SPA.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
