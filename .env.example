# ── SPA (legado AI Studio) ─────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── Backend (server/) ──────────────────────────────────────────────────
# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP del backend NestJS
PORT=3001

# Conexión a PostgreSQL (coincide con docker-compose.yml en local)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm_reclutamiento

# Conexión a Redis para BullMQ (coincide con docker-compose.yml en local)
REDIS_URL=redis://localhost:6379

# ── Canales (opcionales; sin ellos el webhook correspondiente responde 403) ──
# App secret de la app de Meta: firma X-Hub-Signature-256 de los webhooks
# de WhatsApp Cloud API / Messenger / Instagram.
# META_APP_SECRET=

# Token arbitrario que tú defines y pegas igual en el panel de webhooks de
# Meta; se usa en el handshake de verificación (hub.verify_token).
# META_VERIFY_TOKEN=

# Secret que se envía a Telegram al registrar el webhook (setWebhook
# secret_token) y que Telegram devuelve en X-Telegram-Bot-Api-Secret-Token.
# TELEGRAM_WEBHOOK_SECRET=

# Token de acceso de WhatsApp Cloud API (system user): descarga de media
# entrante y envío de mensajes. Sin él, la media queda "pending".
# WHATSAPP_ACCESS_TOKEN=

# Id del número de teléfono en la Cloud API (panel de WhatsApp de la app Meta):
# necesario para ENVIAR mensajes. Sin él, enviar responde CHANNEL_NOT_CONFIGURED.
# WHATSAPP_PHONE_NUMBER_ID=

# Token del bot de Telegram (BotFather): descarga de media vía getFile.
# TELEGRAM_BOT_TOKEN=

# Carpeta local donde se guardan los binarios de media (implementación
# filesystem de MediaStorage; S3/MinIO llegará con la decisión de despliegue).
# MEDIA_STORAGE_DIR=./storage/media

# Bot gateway: URL del webhook del servicio FastAPI del bot y secreto HMAC
# compartido (mín. 16 chars). Sin ellos, el bot queda desconectado.
# BOT_WEBHOOK_URL=http://localhost:8000/crm/webhook
# BOT_SHARED_SECRET=

# Base pública del backend (URLs absolutas para el bot, ej. media). Default:
# http://localhost:<PORT>. Con ngrok, la URL del túnel.
# PUBLIC_BASE_URL=

# Marketing API (read-only, permiso ads_read): sync de campañas reales.
# Sin estos dos, el sync queda deshabilitado y el CSV sigue siendo el fallback.
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_1234567890

# Bases de API (defaults oficiales; solo se cambian en tests o con proxy).
# GRAPH_API_BASE_URL=https://graph.facebook.com/v20.0
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# MARKETING_API_BASE_URL=https://graph.facebook.com/v20.0
